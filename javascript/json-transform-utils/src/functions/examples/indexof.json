[
  {
    "name": "object - found",
    "given": {
      "input": "ABC",
      "definition": {
        "$$indexof": "$",
        "substring": "BC"
      }
    },
    "expect": {
      "equal": 1
    }
  },
  {
    "name": "object - from index",
    "given": {
      "input": "ABCABC",
      "definition": {
        "$$indexof": "$",
        "substring": "B",
        "from": 2
      }
    },
    "expect": {
      "equal": 4
    }
  },
  {
    "name": "object - not found",
    "given": {
      "input": "ABC",
      "definition": {
        "$$indexof": "$",
        "substring": "D"
      }
    },
    "expect": {
      "equal": -1
    }
  },
  {
    "name": "inline - found",
    "given": {
      "input": "ABC",
      "definition": "$$indexof(BC):$"
    },
    "expect": {
      "equal": 1
    }
  },
  {
    "name": "inline - not found",
    "given": {
      "input": "ABC",
      "definition": "$$indexof(D):$"
    },
    "expect": {
      "equal": -1
    }
  }
]
