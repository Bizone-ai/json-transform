[
  {
    "name": "inline - simple",
    "given": {
      "input": {
        "root": ""
      },
      "definition": "$$xml:$"
    },
    "expect": {
      "equal": "<root/>",
      "format": "xml"
    }
  },
  {
    "name": "inline - 2 elements",
    "given": {
      "input": {
        "root": "",
        "root_b": ""
      },
      "definition": "$$xml:$"
    },
    "expect": {
      "equal": ["<root/><root_b/>", "<root_b/><root/>"],
      "format": "xml"
    }
  },
  {
    "name": "inline - 2 elements inside a container",
    "given": {
      "input": {
        "root": "",
        "root_b": ""
      },
      "definition": "$$xml(container):$"
    },
    "expect": {
      "equal": ["<container><root/><root_b/></container>", "<container><root_b/><root/></container>"],
      "format": "xml"
    }
  },
  {
    "name": "inline - indent",
    "given": {
      "input": {
        "root": "",
        "root_b": ""
      },
      "definition": "$$xml(container,true):$"
    },
    "expect": {
      "equal": [
        "<container>\n  <root/>\n  <root_b/>\n</container>\n",
        "<container>\n  <root_b/>\n  <root/>\n</container>\n"
      ],
      "format": "xml"
    }
  },
  {
    "name": "object - simple",
    "given": {
      "input": {
        "root": ""
      },
      "definition": {
        "$$xml": "$",
        "root": "container"
      }
    },
    "expect": {
      "equal": "<container><root/></container>",
      "format": "xml"
    }
  },
  {
    "name": "object - array",
    "given": {
      "input": null,
      "definition": {
        "$$xml": {
          "hello": {
            "hi": ["", ""],
            "to": "world"
          }
        }
      }
    },
    "expect": {
      "equal": "<hello><hi/><hi/><to>world</to></hello>",
      "format": "xml"
    }
  },
  {
    "name": "object - attributes and cdata",
    "given": {
      "input": null,
      "definition": {
        "$$xml": {
          "hello": {
            "@attr": "value",
            "#text": "my data",
            "to": "world"
          }
        }
      }
    },
    "expect": {
      "equal": "<hello attr=\"value\">my data<to>world</to></hello>",
      "format": "xml"
    }
  }
]
