[
  {
    "name": "inline - remove leading and trailing spaces",
    "given": {
      "input": "  hello  ",
      "definition": "$$trim:$"
    },
    "expect": {
      "equal": "hello"
    }
  },
  {
    "name": "inline - remove leading and trailing hyphens",
    "given": {
      "input": "--hello--",
      "definition": "$$trim(BOTH,-):$"
    },
    "expect": {
      "equal": "hello"
    }
  },
  {
    "name": "inline - remove leading and trailing unicode",
    "given": {
      "input": "⚠️hello⚠️",
      "definition": "$$trim(BOTH,⚠️):$"
    },
    "expect": {
      "equal": "hello"
    }
  },
  {
    "name": "inline - remove leading spaces",
    "given": {
      "input": "  hello  ",
      "definition": "$$trim(START):$"
    },
    "expect": {
      "equal": "hello  "
    }
  },
  {
    "name": "inline - remove leading abc characters",
    "given": {
      "input": "abcbchello  ",
      "definition": "$$trim(START,abc):$"
    },
    "expect": {
      "equal": "hello  "
    }
  },
  {
    "name": "inline - remove trailing spaces",
    "given": {
      "input": "  hello  ",
      "definition": "$$trim(END):$"
    },
    "expect": {
      "equal": "  hello"
    }
  },
  {
    "name": "inline - remove trailing abc characters",
    "given": {
      "input": "  helloabcbc",
      "definition": "$$trim(END,abc):$"
    },
    "expect": {
      "equal": "  hello"
    }
  },
  {
    "name": "inline - remove indentation",
    "given": {
      "input": "             <html> \n                 <body> \n                     <p>Hello, world</p> \n                 </body> \n             </html>",
      "inputFormat": "xml",
      "definition": "$$trim(INDENT):$"
    },
    "expect": {
      "equal": "<html>\n    <body>\n        <p>Hello, world</p>\n    </body>\n</html>",
      "format": "xml"
    }
  }
]
