[
  {
    "name": "Inline - empty root element",
    "given": {
      "input": "<root></root>",
      "inputFormat": "xml",
      "definition": "$$xmlparse:$"
    },
    "expect": {
      "equal": {
        "root": ""
      }
    }
  },
  {
    "name": "Inline - nested elements with attributes",
    "given": {
      "input": "<root><hello to=\"world\"><hi /><hi /></hello></root>",
      "inputFormat": "xml",
      "definition": "$$xmlparse:$"
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": ["", ""],
            "@to": "world"
          }
        }
      }
    }
  },
  {
    "name": "Object - empty root element",
    "given": {
      "input": "<root></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$"
      }
    },
    "expect": {
      "equal": {
        "root": ""
      }
    }
  },
  {
    "name": "Object - nested elements with attributes",
    "given": {
      "input": "<root><hello to=\"world\"><hi /><hi /></hello></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$"
      }
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": ["", ""],
            "@to": "world"
          }
        }
      }
    }
  },
  {
    "name": "TestObject - nested single element",
    "given": {
      "input": "<root><hello to=\"world\"><hi><test>X</test></hi></hello></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$"
      }
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": {
              "test": "X"
            },
            "@to": "world"
          }
        }
      }
    }
  },
  {
    "name": "TestObject - force list on nested single element",
    "given": {
      "input": "<root><hello to=\"world\"><hi><test>X</test></hi></hello></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$",
        "array_tags": ["hi"]
      }
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": [
              {
                "test": "X"
              }
            ],
            "@to": "world"
          }
        }
      }
    }
  },
  {
    "name": "TestObject - force list empty",
    "given": {
      "input": "<root><hello to=\"world\"><hi /><hi /></hello></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$",
        "array_tags": ["hi"]
      }
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": ["", ""],
            "@to": "world"
          }
        }
      }
    }
  },
  {
    "name": "TestObject - keep strings as is",
    "given": {
      "input": "<root><hello to=\"2\"><hi>true</hi></hello></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$",
        "keep_strings": true
      }
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": "true",
            "@to": "2"
          }
        }
      }
    }
  },
  {
    "name": "TestObject - automatic type parsing",
    "given": {
      "input": "<root><hello to=\"2\"><hi>true</hi></hello></root>",
      "inputFormat": "xml",
      "definition": {
        "$$xmlparse": "$"
      }
    },
    "expect": {
      "equal": {
        "root": {
          "hello": {
            "hi": true,
            "@to": 2
          }
        }
      }
    }
  }
]
