    },
    "expect": {
      "equal": true
    }
  },
  {
    "name": "false - ipv6 - Address is outside the subnet",
    "given": {
      "input": "2001:dc8:dead:beef:0123:4567:89ab:cdef",
      "definition": "$$cidrtest(2001:db8::/32):$"
    },
    "expect": {
      "equal": false
    }
  },
  {
    "name": "true - ipv6 - Address with compressed zeros is inside a more specific subnet",
    "given": {
      "input": "2a03:2880:f12f:83:face:b00c:0:25de",
      "definition": "$$cidrtest(2a03:2880:f12f::/48):$"
    },
    "expect": {
      "equal": true
    }
  },
  {
    "name": "true - ipv6 - An address that is actually the network address",
    "given": {
      "input": "2001:db8:abcd::",
      "definition": "$$cidrtest(2001:db8:abcd::/48):$"
    },
    "expect": {
      "equal": true
    }
  },
  {
    "name": "true - ipv6 - An address that is the last address in the range",
    "given": {
      "input": "2001:db8:abcd:ffff:ffff:ffff:ffff:ffff",
      "definition": "$$cidrtest(2001:db8:abcd::/48):$"
    },
    "expect": {
      "equal": true
    }
  },
  {
    "name": "false - ipv6 - Invalid IP address input",
